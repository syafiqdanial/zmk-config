#include "zmk-helpers/helper.h"

#define HM_TAPPING_TERM 180
#define HM_TAPPING_TERM_FAST 75
#define HM_PRIOR_IDLE 120
#define COMBO_TERM_FAST 35
#define COMBO_TERM_SLOW 40
#define COMBO_PRIOR_IDLE 80
#define BASE 0
#define NUMS 1
#define DANGER 2

/* use helper macros to define left and right hand keys */

#include "zmk-helpers/key-labels/totem.h"                                   // key-position labels
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right-hand keys
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2                                      // thumb keys

&lt { tapping-term-ms = <175>; };

/ {
    combos {
        compatible = "zmk,combos";

        //INFO: Brackets and braces
        //INFO: System commands
        //INFO: Edit commands
        //INFO: Special characters

        layer_blu {
            bindings = <&mo 3>;
            key-positions = <34 35>;
        };
    };

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <HM_TAPPING_TERM_FAST>;
            require-prior-idle-ms = 0;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <HM_TAPPING_TERM_FAST>;
            require-prior-idle-ms = 0;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };
    };

    macros {
        roundbkt: roundbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "ROUNDBKT";
        };

        squarebkt: squarebkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "SQUAREBKT";
        };

        curlbkt: curlbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "CURLBKT";
        };

        workemail: workemail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp Y &kp A &kp F &kp I &kp Q &kp MINUS &kp D &kp A &kp N &kp I &kp A &kp L &kp DOT &kp Z &kp U &kp L &kp K &kp I &kp F &kp L &kp I &kp AT &kp H &kp P &kp DOT &kp C &kp O &kp M>;
            label = "WORKEMAIL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
       &kp Q             &kp W         &kp E                 &kp R          &kp T          &kp Y       &kp U          &kp I                  &kp O         &kp P
       &hm_l LEFT_GUI A  &hm_l LALT S  &hm_l LEFT_CONTROL D  &hm_l LSHFT F  &kp G          &kp H       &hm_r RSHFT J  &hm_r RIGHT_CONTROL K  &hm_r RALT L  &hm_r SEMICOLON SQT 
&kp Q  &kp Z             &kp X         &kp C                 &kp V          &kp B          &lt 2 N     &kp M          &kp COMMA              &kp DOT       &hm_r BACKSLASH SLASH   &kp SLASH
                                       &kp ESC               &lt 2 TAB      &lt 1 SPACE    &lt 4 BSPC  &kp DEL        &kp ENTER
            >;
        };

        Numbers {
            display-name = "NUMS";
            bindings = <
              &kp PLUS         &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp HOME      &kp UP_ARROW  &kp END    &kp PAGE_UP
              &kp MINUS        &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp N0                  &kp EQUAL              &kp LEFT      &kp DOWN      &kp RIGHT  &kp PAGE_DOWN
&kp NUMBER_6  &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8   &kp N9        &kp PERIOD              &none                  &kp CAPSLOCK  &none         &none      &none          &kp NUMBER_6
                                             &kp KP_DIVIDE  &trans        &trans                  &kp BSPC               &kp DELETE    &kp ENTER
            >;
        };

        Symbols {
            display-name = "SYM";
            bindings = <
       &roundbkt    &squarebkt  &curlbkt       &kp GRAVE      &kp TILDE    &kp CARET  &kp F1  &kp F2   &kp F3   &kp F4
       &kp EXCL     &kp AT      &kp HASH       &kp DOLLAR     &kp PIPE     &trans     &kp F5  &kp F6   &kp F7   &kp F8
&none  &kp PERCENT  &kp CARET   &kp AMPERSAND  &kp BACKSLASH  &kp UNDER    &trans     &kp F9  &kp F10  &kp F11  &kp F12  &trans
                                &trans         &trans         &trans       &trans     &trans  &trans
            >;
        };

        Bluetooth {
            bindings = <
            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none        &none              &none            &bt BT_CLR    &none
            &trans        &none         &none         &none         &none           &none        &kp K_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DN  &kp C_BRI_UP
&workemail  &none         &none         &none         &none         &bootloader     &bootloader  &none              &none            &none         &none         &none
                                        &sys_reset    &none         &none           &none        &none              &sys_reset
            >;
        };

        Scrolling {
            bindings = <
       &none  &none  &none  &none  &none    &none  &kp HOME  &kp END  &kp PG_DN  &kp PG_UP
       &none  &none  &none  &none  &none    &none  &none     &none    &none      &none
&none  &none  &none  &none  &none  &none    &none  &none     &none    &none      &none      &none
                     &none  &none  &none    &none  &none     &none
            >;
        };
    };
};
